# Variables de entorno del monitor. En la nube se cargan en el panel de la plataforma;
# en local: cp .env.example .env && node --env-file=.env server.js
MODO_PRUEBA=true
TOKEN_GATEWAY=pon-aqui-un-texto-largo-y-secreto-de-32-caracteres
PANEL_USUARIO=granja
PANEL_CLAVE=una-clave-para-el-panel
ZONA_HORARIA=America/Santiago
GALPONES=Galpón 1,Galpón 2,Galpón 3,Galpón 4

# DevEUI:galpón:nombre[:luz]  (galpón 0 = general)
SENSORES=24E1240000000001:1:Inicio;24E1240000000002:1:Fondo;24E1240000000003:2:Inicio;24E1240000000004:2:Fondo;24E1240000000005:3:Inicio;24E1240000000006:3:Fondo;24E1240000000007:4:Inicio;24E1240000000008:4:Fondo;24E1240000000009:0:Tablero general:luz

# Umbrales (°C, %, minutos)
CALOR_AVISO=28
CALOR_CRITICO=31
FRIO=14
HUMEDAD_ALTA=80
HUMEDAD_MINUTOS=30
SIN_DATOS_MINUTOS=20
HISTERESIS=0.5
REPETIR_AVISO_MIN=60
REPETIR_CRITICO_MIN=15
VALOR_CON_LUZ=1

# CallMeBot: WhatsApp (apikey) y llamada por Telegram (usuario)
CONTACTO_1_NOMBRE=Persona 1
CONTACTO_1_WHATSAPP=+56900000001
CONTACTO_1_APIKEY=
CONTACTO_1_TELEGRAM=@usuario1
CONTACTO_2_NOMBRE=Persona 2
CONTACTO_2_WHATSAPP=+56900000002
CONTACTO_2_APIKEY=
CONTACTO_2_TELEGRAM=@usuario2
CONTACTO_3_NOMBRE=Persona 3
CONTACTO_3_WHATSAPP=+56900000003
CONTACTO_3_APIKEY=
CONTACTO_3_TELEGRAM=@usuario3

LLAMADAS_PROVEEDOR=callmebot
MINUTOS_ENTRE_LLAMADAS=5
# Solo si LLAMADAS_PROVEEDOR=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DESDE=

# Opcional: recibir por MQTT en vez de (o además de) HTTP
MQTT_URL=
MQTT_USUARIO=
MQTT_CLAVE=
MQTT_TEMA=milesight/uplink/#
